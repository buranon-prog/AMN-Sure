# SQLite by default (zero-config). For production use Postgres, e.g.
# postgresql://user:password@localhost:5432/amn_service
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret"

# Required when running in production behind your own reverse proxy (HTTPS).
AUTH_TRUST_HOST=true

# Location tracking window (Asia/Bangkok local time). Location pings sent
# outside this window — or while the technician has no open shift — are
# rejected by the server, so tracking only ever happens during work hours.
TRACKING_START="07:00"
TRACKING_END="20:00"

# Web Push (phone notifications when a job is assigned). Generate once with:
#   npx web-push generate-vapid-keys
# Leave empty to run with in-app notifications only.
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:it@your-company.co.th"
