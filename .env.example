# SQLite by default (zero-config). For production, point this at Postgres instead,
# e.g. postgresql://user:password@localhost:5432/amnsure
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret"

# Required in production (NODE_ENV=production): Auth.js rejects the request
# Host header unless it's told to trust it. Set this to true only when the
# app sits behind a reverse proxy/VPN you control (matches the "internal
# only" deployment this app is meant for). See:
# https://errors.authjs.dev#untrustedhost
AUTH_TRUST_HOST=true
